<Window
    x:Class="AdminWorks.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AdminWorks.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="ADMINWORKS PRO - WINDOWS 11">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Custom TitleBar -->
            <RowDefinition Height="Auto" /> <!-- Telemetry Bar -->
            <RowDefinition Height="*" />    <!-- Navigation & Main Cards -->
            <RowDefinition Height="Auto" /> <!-- Collapsible Terminal Drawer -->
        </Grid.RowDefinitions>

        <!-- 1. Custom TitleBar (Native Snap Layouts compatible) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" Foreground="#60A5FA" FontSize="16" />
                <TextBlock Text="ADMINWORKS" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                <Border Background="#1A2230" CornerRadius="4" Padding="6,2" BorderBrush="#2E384E" BorderThickness="1">
                    <TextBlock Text="v6.0 PRO" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA" />
                </Border>
                <Border x:Name="UpdateBadge" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="Collapsed" Tapped="UpdateBadge_Tapped">
                    <TextBlock x:Name="UpdateBadgeText" Text="UPDATE" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                </Border>
                <TextBlock Text="Windows 11 • Kushagra Karira" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- Center System Badge -->
            <TextBlock x:Name="SystemBadgeText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="11.5" Foreground="#9CA3AF" />

            <!-- Search Box Pill -->
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" Width="260" Margin="0,0,16,0"
                            PlaceholderText="Search tools, tweaks &amp; features..."
                            QueryIcon="Find" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" />
        </Grid>

        <!-- 2. Telemetry Bar (4 Modern Win11 Metric Cards) -->
        <Grid Grid.Row="1" Background="#111622" BorderBrush="#1F2839" BorderThickness="0,1,0,1" Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU Metric -->
            <Border Grid.Column="0" Background="#1A202C" CornerRadius="8" Padding="12,8" Margin="4,0" BorderBrush="#2D3748" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#60A5FA" />
                        <TextBlock Text="CPU LOAD" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" />
                    </StackPanel>
                    <TextBlock x:Name="CpuText" Grid.Row="1" Text="--% Utilization" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <ProgressBar x:Name="CpuBar" Grid.Row="2" Value="0" Maximum="100" Height="4" Foreground="#3B82F6" />
                </Grid>
            </Border>

            <!-- RAM Metric -->
            <Border Grid.Column="1" Background="#1A202C" CornerRadius="8" Padding="12,8" Margin="4,0" BorderBrush="#2D3748" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#60A5FA" />
                        <TextBlock Text="MEMORY USED" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" />
                    </StackPanel>
                    <TextBlock x:Name="RamText" Grid.Row="1" Text="-- / -- GB" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <ProgressBar x:Name="RamBar" Grid.Row="2" Value="0" Maximum="100" Height="4" Foreground="#10B981" />
                </Grid>
            </Border>

            <!-- Disk Metric -->
            <Border Grid.Column="2" Background="#1A202C" CornerRadius="8" Padding="12,8" Margin="4,0" BorderBrush="#2D3748" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#60A5FA" />
                        <TextBlock Text="SYSTEM DRIVE (C:)" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" />
                    </StackPanel>
                    <TextBlock x:Name="DiskText" Grid.Row="1" Text="-- GB Free" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <ProgressBar x:Name="DiskBar" Grid.Row="2" Value="0" Maximum="100" Height="4" Foreground="#10B981" />
                </Grid>
            </Border>

            <!-- Uptime Metric -->
            <Border Grid.Column="3" Background="#1A202C" CornerRadius="8" Padding="12,8" Margin="4,0" BorderBrush="#2D3748" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#60A5FA" />
                        <TextBlock Text="SYSTEM UPTIME" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" />
                    </StackPanel>
                    <TextBlock x:Name="UptimeText" Grid.Row="1" Text="--d --h --m" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Navigation View & Tweak Cards List -->
        <NavigationView x:Name="NavView" Grid.Row="2" PaneDisplayMode="Left" IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged" OpenPaneLength="240">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Maintenance" Tag="Maintenance" Icon="Repair" />
                <NavigationViewItem Content="Performance" Tag="Performance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network &amp; DNS" Tag="Network &amp; DNS">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Privacy &amp; Bloat" Tag="Privacy &amp; Bloat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shell &amp; Explorer" Tag="Shell &amp; Explorer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hardware Audit" Tag="Hardware">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F8;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Software Hub" Tag="Software Hub">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB49;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Admin Utilities" Tag="Admin Utilities">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EF;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="20,14" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CardsContainer">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TweakItem">
                            <!-- Native Windows 11 SettingsCard style -->
                            <Border Background="#1A202C" CornerRadius="8" BorderBrush="#2D3748" BorderThickness="1"
                                    Margin="0,0,0,10" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Leading Icon -->
                                    <Border Width="36" Height="36" CornerRadius="6" Background="#242C3D" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Title & Description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13.5" />
                                            <Border Background="#263044" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind CategoryTag}" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Trailing Action: Native Win11 ToggleSwitch OR Accent Button -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <!-- If Toggle -->
                                        <ToggleSwitch IsOn="{x:Bind IsActive, Mode=TwoWay}"
                                                      Toggled="TweakToggle_Toggled"
                                                      Visibility="{x:Bind ToggleVisibility}"
                                                      IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}" />

                                        <!-- If Action Button -->
                                        <Button Content="Apply" Click="ApplyButton_Click" Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{x:Bind ActionVisibility}"
                                                IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                                                MinWidth="88" Height="32" CornerRadius="6" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </NavigationView>

        <!-- 4. Bottom Collapsible Console Output Drawer -->
        <Grid x:Name="ConsoleDrawer" Grid.Row="3" Background="#0A0C10" BorderBrush="#1F2839" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition x:Name="ConsoleContentRow" Height="140" />
            </Grid.RowDefinitions>

            <!-- Console Header Bar -->
            <Grid Grid.Row="0" Padding="14,0" Background="#0F1218">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="#10B981" />
                    <TextBlock Text="CONSOLE OUTPUT &amp; EXECUTION LOG" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Clear" Click="ConsoleClear_Click" Height="24" FontSize="10" Padding="8,0" CornerRadius="4" />
                    <Button Content="Copy All" Click="ConsoleCopy_Click" Height="24" FontSize="10" Padding="8,0" CornerRadius="4" />
                    <Button Content="Export" Click="ConsoleExport_Click" Height="24" FontSize="10" Padding="8,0" CornerRadius="4" />
                    <Button x:Name="ToggleDrawerBtn" Content="Collapse" Click="ToggleDrawer_Click" Height="24" FontSize="10" Padding="8,0" CornerRadius="4" Foreground="#60A5FA" />
                </StackPanel>
            </Grid>

            <!-- Console Log List -->
            <ListView x:Name="ConsoleList" Grid.Row="1" ItemsSource="{x:Bind ExecutionSvc.Logs}"
                      SelectionMode="None" Padding="12,6" Background="#06080B">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LogEntry">
                        <TextBlock FontFamily="Consolas" FontSize="11.5" Foreground="#D1D5DB" Margin="0,1">
                            <Run Text="{x:Bind Header}" Foreground="#60A5FA" />
                            <Run Text=" " />
                            <Run Text="{x:Bind Message}" />
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
